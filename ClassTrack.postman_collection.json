{
  "info": {
    "name": "ClassTrack API",
    "description": "Colección completa de endpoints del backend ClassTrack. Ejecutar en orden: Auth → Profile → Courses → Students → Attendance → Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "teacherToken", "value": "", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" },
    { "key": "courseId", "value": "", "type": "string" },
    { "key": "sessionId", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar Docente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('teacherToken', json.data.token);",
                  "    console.log('Teacher token saved:', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Profesor Demo\",\n  \"email\": \"teacher@classtrack.com\",\n  \"password\": \"Password123\",\n  \"role\": \"TEACHER\"\n}"
            }
          }
        },
        {
          "name": "Registrar Estudiante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('studentToken', json.data.token);",
                  "    pm.collectionVariables.set('studentId', json.data.userId);",
                  "    console.log('Student token saved:', json.data.token);",
                  "    console.log('Student ID saved:', json.data.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Estudiante Demo\",\n  \"email\": \"student@classtrack.com\",\n  \"password\": \"Password123\",\n  \"role\": \"STUDENT\"\n}"
            }
          }
        },
        {
          "name": "Login Docente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('teacherToken', json.data.token);",
                  "    console.log('Teacher token saved:', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@classtrack.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Login Estudiante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('studentToken', json.data.token);",
                  "    console.log('Student token saved:', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@classtrack.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Registro — Email duplicado (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicado\",\n  \"email\": \"teacher@classtrack.com\",\n  \"password\": \"Password123\",\n  \"role\": \"TEACHER\"\n}"
            }
          }
        },
        {
          "name": "Login — Credenciales inválidas (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@classtrack.com\",\n  \"password\": \"WrongPass\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Obtener Perfil (Docente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/profile"
          }
        },
        {
          "name": "Obtener Perfil (Estudiante)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/profile"
          }
        },
        {
          "name": "Identificación Digital (Docente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/profile/digital-id"
          }
        },
        {
          "name": "Identificación Digital (Estudiante)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/profile/digital-id"
          }
        },
        {
          "name": "Perfil sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/profile"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Crear Curso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('courseId', json.data.id);",
                  "    console.log('Course ID saved:', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desarrollo Móvil\",\n  \"description\": \"Curso de Android con Kotlin y Jetpack Compose\"\n}"
            }
          }
        },
        {
          "name": "Listar Cursos (Docente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/courses"
          }
        },
        {
          "name": "Listar Cursos (Estudiante)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/courses"
          }
        },
        {
          "name": "Obtener Detalle de Curso",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        },
        {
          "name": "Crear Curso — Estudiante no autorizado (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Intento no autorizado\",\n  \"description\": \"No debería crearse\"\n}"
            }
          }
        },
        {
          "name": "Eliminar Curso",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Course Students",
      "item": [
        {
          "name": "Vincular Estudiante a Curso",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}/courses/{{courseId}}/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}}\n}"
            }
          }
        },
        {
          "name": "Vincular Estudiante — Duplicado (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}/courses/{{courseId}}/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}}\n}"
            }
          }
        },
        {
          "name": "Listar Estudiantes del Curso",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/students"
          }
        },
        {
          "name": "Desvincular Estudiante",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/students/{{studentId}}"
          }
        }
      ]
    },
    {
      "name": "Attendance Sessions",
      "item": [
        {
          "name": "Crear Sesión de Asistencia",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('sessionId', json.data.sessionId);",
                  "    console.log('Session ID saved:', json.data.sessionId);",
                  "    console.log('QR Token:', json.data.qrToken);",
                  "    console.log('Expires at:', json.data.expiresAt);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}/attendance/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}}\n}"
            }
          }
        },
        {
          "name": "Obtener Detalle de Sesión",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/attendance/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Cerrar Sesión",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/attendance/sessions/{{sessionId}}/close"
          }
        },
        {
          "name": "Cerrar Sesión — Ya cerrada (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/attendance/sessions/{{sessionId}}/close"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Registrar Asistencia (Check-in)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/attendance/checkin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"latitude\": 7.1205,\n  \"longitude\": -73.1221\n}"
            }
          }
        },
        {
          "name": "Check-in — Asistencia duplicada (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/attendance/checkin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"latitude\": 7.1205,\n  \"longitude\": -73.1221\n}"
            }
          }
        },
        {
          "name": "Check-in — GPS inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/attendance/checkin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"latitude\": 999.99,\n  \"longitude\": -73.1221\n}"
            }
          }
        },
        {
          "name": "Listar Asistentes de Sesión",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/attendance/sessions/{{sessionId}}/records"
          }
        },
        {
          "name": "Historial de Asistencia (Estudiante)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/attendance/history"
          }
        },
        {
          "name": "Historial — Docente no autorizado (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/attendance/history"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Reporte de Sesión",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/reports/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Reporte de Curso",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/reports/courses/{{courseId}}"
          }
        },
        {
          "name": "Reporte de Estudiante (Docente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/reports/students/{{studentId}}"
          }
        },
        {
          "name": "Reporte de Estudiante (Propio)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/reports/students/{{studentId}}"
          }
        }
      ]
    }
  ]
}
